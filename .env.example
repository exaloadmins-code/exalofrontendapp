# Copy to `.env` for local Expo development. Do not commit `.env`.
#
# Backend API origin (no trailing slash). Examples:
#   Web / iOS simulator:  http://127.0.0.1:8000
#   Android emulator:     http://10.0.2.2:8000
#   Physical device LAN:  http://YOUR_LAN_IP:8000
# Start backend bound to all interfaces for device testing, e.g.:
#   uvicorn app.main:app --host 0.0.0.0 --port 8000
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# TEMPORARY development user PK for Train API (B1.3).
# Must match an existing users.id in your exam_prep database
# (default seed demo user is often id=1 / student@example.com).
# Replace during Identity/Profile integration — this is not authentication.
EXPO_PUBLIC_DEV_USER_ID=1
